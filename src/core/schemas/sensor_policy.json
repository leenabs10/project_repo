{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "source_manifest_sha256", "source_split", "training_groups", "basis", "evidence_sha256", "bounds", "physical_sensor_realism_certified"],
  "properties": {
    "schema_version": {"const": "dubaidata/1.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "source_manifest_sha256": {"$ref": "#/$defs/hash"},
    "source_split": {"const": "train"},
    "training_groups": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sensor_id": {"type": "string", "minLength": 1},
    "basis": {"const": "training_distribution_bounds_not_sensor_calibration"},
    "physical_sensor_realism_certified": {"const": false},
    "evidence_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "bounds": {"type": "object", "additionalProperties": false,
      "required": ["rgb_gain_range", "mean_luma_range", "bright_luma_fraction_max", "valid_depth_fraction_range", "hidden_valid_fraction_min", "hidden_valid_fraction_max", "rgb_mean_absolute_change_min"],
      "properties": {
        "rgb_gain_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "mean_luma_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 255}},
        "bright_luma_fraction_max": {"type": "number", "minimum": 0, "maximum": 1},
        "valid_depth_fraction_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "hidden_valid_fraction_min": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "hidden_valid_fraction_max": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "rgb_mean_absolute_change_min": {"type": "number", "exclusiveMinimum": 0, "maximum": 255}
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
