{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "dataset_id", "sample_id", "group_id", "split", "timestamp_seconds", "timestamp_basis", "image_size", "modalities", "source_metadata"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "dubaidata/1.0"},
    "dataset_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
    "sample_id": {"type": "string", "minLength": 1},
    "group_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "timestamp_seconds": {"type": "number", "minimum": 0},
    "timestamp_basis": {"type": "string", "minLength": 1},
    "image_size": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
    "camera": {"type": "object", "required": ["sensor_id", "image_convention", "intrinsics"], "properties": {
      "sensor_id": {"type": "string", "minLength": 1},
      "image_convention": {"type": "string", "minLength": 1},
      "intrinsics": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
    }},
    "modalities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["available", "unsupported", "missing"]},
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "units": {"type": "string", "minLength": 1},
          "scale_to_metres": {"type": "number", "exclusiveMinimum": 0},
          "invalid_raw_value": {"type": "integer", "minimum": 0, "maximum": 65535},
          "frame": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "available"}}}, "then": {"required": ["path"]}},
          {"if": {"properties": {"status": {"enum": ["unsupported", "missing"]}}}, "then": {"required": ["reason"], "not": {"required": ["path"]}}}
        ]
      }
    },
    "source_metadata": {"type": "object"}
  }
}
