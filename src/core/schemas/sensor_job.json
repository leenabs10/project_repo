{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "job_id", "backend", "dataset_id", "source_manifest_sha256", "quality_policy_sha256", "source_split", "source_sample_ids", "seed", "required_modalities", "controls", "conditions"],
  "properties": {
    "schema_version": {"const": "dubaidata/1.0"},
    "kind": {"const": "generate_sensor_conditions"},
    "job_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
    "backend": {"const": "real_sensor_conditions"},
    "dataset_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"},
    "source_manifest_sha256": {"$ref": "#/$defs/hash"},
    "quality_policy_sha256": {"$ref": "#/$defs/hash"},
    "source_split": {"const": "train"},
    "source_sample_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "required_modalities": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["rgb", "depth", "semantic", "lidar"]}, "allOf": [{"contains": {"const": "rgb"}}, {"contains": {"const": "depth"}}]},
    "controls": {"type": "object", "additionalProperties": false, "required": ["preserve", "prohibit"], "properties": {
      "preserve": {"const": ["native_geometry", "labels", "calibration", "pose", "timestamps", "retained_depth", "unvaried_modalities"]},
      "prohibit": {"const": ["geometry_warp", "depth_noise", "lidar_corruption", "label_rewrite"]}
    }},
    "conditions": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["condition_id", "method", "gain"], "properties": {
        "condition_id": {"$ref": "#/$defs/id"}, "method": {"const": "rgb_gain"}, "gain": {"type": "number", "exclusiveMinimum": 0}
      }},
      {"type": "object", "additionalProperties": false, "required": ["condition_id", "method", "donor_sample_ids"], "properties": {
        "condition_id": {"$ref": "#/$defs/id"}, "method": {"const": "depth_mask_transfer"},
        "donor_sample_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }}
    ]}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"}
  }
}
